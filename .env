# --- Backend (Go) ---
PORT=5000
DATABASE_URL=postgres://myuser:mysecretpassword@postgres_db:5432/mydatabase?sslmode=disable

# --- Database (PostgreSQL) ---
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=mydatabase

# --- Frontend (Nuxt) ---
# Переменные для Nuxt (если нужны на клиенте, должны начинаться с NUXT_PUBLIC_)
NUXT_PUBLIC_API_BASE=http://localhost:5000